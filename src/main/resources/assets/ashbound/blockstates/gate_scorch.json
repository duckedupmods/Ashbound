{
  "multipart": [
    {
      "when": {
        "floor": "true"
      },
      "apply": [
        {
          "model": "ashbound:block/gate_scorch",
          "y": 0
        },
        {
          "model": "ashbound:block/gate_scorch",
          "y": 90
        },
        {
          "model": "ashbound:block/gate_scorch",
          "y": 180
        },
        {
          "model": "ashbound:block/gate_scorch",
          "y": 270
        }
      ]
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "ashbound:block/gate_scorch_wall",
        "y": 0
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "ashbound:block/gate_scorch_wall",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "ashbound:block/gate_scorch_wall",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "ashbound:block/gate_scorch_wall",
        "y": 270
      }
    }
  ]
}